# axis-ai-cron — card-evaluator 등 LLM+DB 전용 CronJob (Playwright/torch 제외).
# pyproject.toml 의 dependency-group "cron" 만 설치 (~수백 MB vs full ~6GB).

# ── builder ──────────────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential gcc \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /uvx /usr/local/bin/

COPY pyproject.toml uv.lock ./

ENV UV_LINK_MODE=copy
# cron group 만 export (--frozen 시 lock 전체가 섞여 torch 등 full deps 유입됨).
RUN uv export --no-emit-project --no-hashes --group cron \
        --format requirements-txt -o /tmp/requirements.txt \
    && uv pip install --system --no-cache -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

# ── runtime ──────────────────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# CronJob 별 최소 src/scripts 만 복사 (Playwright/torch 제외).
COPY src/config ./src/config
COPY src/db ./src/db
COPY src/evaluators ./src/evaluators
COPY scripts/__init__.py ./scripts/__init__.py
COPY scripts/evaluate_recent_cards.py ./scripts/evaluate_recent_cards.py
COPY scripts/postprocess_singleton_clusters.py ./scripts/postprocess_singleton_clusters.py

ENV PYTHONPATH=/app

USER 65534

CMD ["python", "-m", "scripts.evaluate_recent_cards"]
