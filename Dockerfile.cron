# axis-ai-cron — lightweight DB cron image (Playwright/torch 제외).
# pyproject.toml 의 dependency-group "cron" 만 설치 (~수백 MB vs full ~6GB).

# ── builder ──────────────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential gcc \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /uvx /usr/local/bin/

COPY pyproject.toml uv.lock ./

ENV UV_LINK_MODE=copy
# --only-group: 기존 --group 은 "프로젝트 deps + cron group" 이라 torch/playwright 등
# full deps 가 유입돼 cron 이미지가 ~3.3GB 였음 (Harbor artifact 실측, 2026-06-11).
# cron group 단독 export 로 의도했던 경량 이미지로 복원.
RUN uv export --no-emit-project --no-hashes --only-group cron \
        --format requirements-txt -o /tmp/requirements.txt \
    && uv pip install --system --no-cache -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

# ── runtime ──────────────────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# CronJob 별 최소 src/scripts 만 복사 (Playwright/torch 제외).
COPY src/config ./src/config
COPY src/db ./src/db
COPY scripts/__init__.py ./scripts/__init__.py
COPY scripts/postprocess_singleton_clusters.py ./scripts/postprocess_singleton_clusters.py

ENV PYTHONPATH=/app

USER 65534

CMD ["python", "-c", "print('axis-ai-cron image ready')"]
