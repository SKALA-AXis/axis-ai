Project axis_ai {
  database_type: "PostgreSQL"
  Note: '''
    axis-ai DB contract after V30.
    Scope is the tables axis-ai writes or reads directly. Legacy tables removed
    by V30 are preserved row-by-row in legacy_records and are not active write
    targets anymore.
  '''
}

Table peer_companies {
  id varchar(50) [pk]
  name varchar(100) [not null]
  tier varchar(20) [not null, default: "domestic"]
  keywords text[] [default: "{}"]
  dart_period text
  dart_revenue_krwbn numeric(18,2)
  dart_operating_profit_krwbn numeric(18,2)
  dart_operating_margin_pct numeric(9,4)
  dart_revenue_growth_pct numeric(9,4)
  dart_operating_profit_growth_pct numeric(9,4)
  ax_revenue_share_pct numeric(9,4)
  contract_count int [not null, default: 0]
  core_keywords text[] [not null, default: "{}"]
  peer_plus_payload jsonb [not null, default: "{}"]
  financial_history jsonb [not null, default: "[]"]
  job_posting_history jsonb [not null, default: "[]"]
  legacy_payload jsonb [not null, default: "{}"]
  financial_updated_at timestamptz
  is_active boolean [default: true]
  created_at timestamptz
}

Table crawl_cursors {
  source_name varchar(100) [pk]
  cursor_date date [not null]
  until_date date [not null]
  window_days int [not null]
  max_windows_per_run int [not null, default: 1]
  enabled boolean [not null, default: true]
  updated_at timestamptz [not null]
}

Table raw_articles {
  id bigint [pk, increment]
  source_type varchar(50) [not null]
  source_name varchar(100) [not null]
  publisher varchar(150)
  title varchar(500) [not null]
  content text
  url text [not null, unique]
  url_hash varchar(32) [not null]
  published_at timestamptz
  collected_at timestamptz [not null]
  company jsonb [not null, default: "[]"]
  language varchar(10) [not null, default: "ko"]
  content_type varchar(30) [not null, default: "news"]
  crawl_status varchar(20) [not null, default: "success"]
  error_message text
  processing_status varchar(40) [not null, default: "RAW"]
  metadata jsonb [not null, default: "{}"]
  relevance_score float
  relevance_label varchar(20)
  relevance_reason text
  matched_companies jsonb [not null, default: "[]"]
  matched_sectors jsonb [not null, default: "[]"]
  cluster_id bigint
  is_representative boolean
  importance_level varchar(20)
  importance_score float
  qdrant_vector_id uuid
  crawl_run_id uuid
  peer_company_ids text[] [not null, default: "{}"]
  peer_company_links jsonb [not null, default: "[]"]
  financial_metrics jsonb [not null, default: "[]"]
  business_signals jsonb [not null, default: "[]"]
  crawl_events jsonb [not null, default: "[]"]
  legacy_payload jsonb [not null, default: "{}"]

  indexes {
    url [unique]
    url_hash
    source_type
    source_name
    published_at
    processing_status
    company [type: gin]
    matched_companies [type: gin]
    matched_sectors [type: gin]
    peer_company_ids [type: gin]
    cluster_id
    is_representative
    qdrant_vector_id
  }
}

Table raw_article_source_metadata {
  raw_article_id bigint [pk]
  source_type varchar(50) [not null]
  source_name varchar(100)
  source_metadata jsonb [not null, default: "{}"]
  external_id text
  period text
  document_url text
  company_name text
  parser_quality_label text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table raw_article_parse_results {
  raw_article_id bigint [pk]
  parser_version text
  parse_status text
  parser_quality_label text
  parser_result jsonb [not null, default: "{}"]
  financial_record jsonb [not null, default: "{}"]
  raw_payload jsonb [not null, default: "{}"]
  warnings jsonb [not null, default: "[]"]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table card_news {
  id varchar(50) [pk]
  company varchar(50) [not null]
  peer_company_id varchar(50)
  cluster_id bigint
  title varchar(500) [not null]
  summary_lines text[] [not null, default: "{}"]
  event_type varchar(50) [default: "tech"]
  importance varchar(20) [default: "low"]
  importance_score float [default: 0.0]
  implication jsonb [not null, default: "{}"]
  sources jsonb [not null, default: "[]"]
  primary_keyword_category varchar(80)
  keyword_categories jsonb [not null, default: "[]"]
  keywords text[] [not null, default: "{}"]
  keyword_frequency jsonb [not null, default: "{}"]
  source_raw_article_ids bigint[] [not null, default: "{}"]
  source_articles jsonb [not null, default: "[]"]
  evidence_payload jsonb [not null, default: "{}"]
  image_assets jsonb [not null, default: "[]"]
  legacy_payload jsonb [not null, default: "{}"]
  validation_pass boolean [default: false]
  validation_sc_score float [default: 0.0]
  created_at timestamptz

  indexes {
    peer_company_id
    cluster_id
    event_type
    importance
    validation_pass
    keywords [type: gin]
    keyword_categories [type: gin]
    source_raw_article_ids [type: gin]
  }
}

Table market_price_ohlcv {
  id bigint [pk, increment]
  raw_article_id bigint
  instrument_id bigint [note: "Legacy id kept for payload traceability; no active FK after V30."]
  peer_id text
  peer_company_id varchar(50)
  ticker text [not null]
  exchange varchar(20) [not null, default: "KRX"]
  instrument_name varchar(100)
  trade_date date [not null]
  open numeric
  high numeric
  low numeric
  close numeric
  volume bigint
  change_pct numeric
  currency text [default: "KRW"]
  source_type text [not null, default: "market_data"]
  source_name text
  publisher text
  collected_at timestamptz
  payload jsonb [not null, default: "{}"]
  instrument_payload jsonb [not null, default: "{}"]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (ticker, trade_date, source_name) [unique]
    (peer_company_id, trade_date)
    (exchange, ticker, trade_date)
    raw_article_id
  }
}

Table briefing_reports {
  id varchar(40) [pk]
  title varchar(500) [not null]
  briefing_type varchar(20) [not null]
  date_from date [not null]
  date_to date [not null]
  report_date date
  period_label text
  status varchar(20) [not null, default: "queued"]
  progress numeric(3,2) [not null, default: 0.0]
  key_summary text
  sk_implication text
  related_card_ids text[] [not null, default: "{}"]
  related_raw_article_ids bigint[] [not null, default: "{}"]
  recipients jsonb [not null, default: "[]"]
  delivery_history jsonb [not null, default: "[]"]
  payload jsonb
  legacy_payload jsonb [not null, default: "{}"]
  error_message text
  confidence numeric(3,2)
  provenance jsonb
  created_at timestamptz [not null]
  completed_at timestamptz
}

Table mixer_results {
  id uuid [pk]
  source_analysis_id varchar(100) [unique]
  title varchar(300)
  input_card_ids text[] [not null, default: "{}"]
  input_peer_ids text[] [not null, default: "{}"]
  input_keywords text[] [not null, default: "{}"]
  generated_implication jsonb [not null, default: "{}"]
  sk_ax_implication text
  final_one_liner text
  confidence numeric(3,2)
  payload jsonb [not null, default: "{}"]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table insight_reports {
  id uuid [pk]
  source_analysis_id varchar(100) [unique]
  title varchar(300)
  insight_type varchar(40) [not null, default: "cascade"]
  status varchar(30) [not null, default: "completed"]
  focus_peer_ids text[] [not null, default: "{}"]
  focus_card_ids text[] [not null, default: "{}"]
  focus_keywords text[] [not null, default: "{}"]
  summary text
  final_one_liner text
  sk_ax_implication text
  evidence jsonb [not null, default: "[]"]
  source_card_ids text[] [not null, default: "{}"]
  confidence numeric(3,2)
  payload jsonb [not null, default: "{}"]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table global_industry_trends {
  id uuid [pk]
  source_analysis_id varchar(100) [unique]
  trend_date date [not null]
  industry varchar(100) [not null]
  region varchar(50) [not null, default: "global"]
  keyword varchar(120) [not null]
  keyword_category varchar(80)
  title varchar(300)
  summary text
  mention_count int [not null, default: 0]
  impact_score numeric(5,2)
  confidence numeric(3,2)
  related_peer_ids text[] [not null, default: "{}"]
  related_card_ids text[] [not null, default: "{}"]
  source_raw_article_ids bigint[] [not null, default: "{}"]
  sk_ax_implication text
  payload jsonb [not null, default: "{}"]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table legacy_records {
  id bigint [pk, increment]
  source_table varchar(100) [not null]
  source_pk text
  owner_table varchar(100)
  owner_id text
  payload jsonb [not null]
  archived_at timestamptz [not null]

  Note: "V30 row-level archive for collapsed legacy tables. axis-ai only appends compatibility logs here."
}

Ref: raw_article_source_metadata.raw_article_id - raw_articles.id
Ref: raw_article_parse_results.raw_article_id - raw_articles.id
Ref: card_news.peer_company_id > peer_companies.id
Ref: market_price_ohlcv.raw_article_id > raw_articles.id
Ref: market_price_ohlcv.peer_company_id > peer_companies.id
