Project axis_ai {
  database_type: "PostgreSQL"
  Note: '''
    Current axis-ai DB schema from code write/read paths only.

    Source of truth used for this DBML:
    - src/db/article_store.py
    - src/agents/crawler_agent.py
    - src/agents/credibility_agent.py
    - src/agents/relevance_agent.py
    - src/agents/dedup_agent.py
    - src/agents/classification_agent.py
    - src/rag/vector_index.py
  '''
}

Table raw_articles {
  id bigint [pk, increment]

  source_type varchar(50) [not null]
  source_name varchar(100) [not null]
  publisher varchar(150)

  title varchar(500) [not null]
  content text
  url text [not null, unique]
  url_hash varchar(32) [not null]

  published_at timestamptz
  collected_at timestamptz [not null]

  company jsonb [not null, default: "[]", note: "Array of company ids. Industry-only material is stored as ['industry_trend']."]
  language varchar(10) [not null, default: "ko"]
  content_type varchar(30) [not null]

  crawl_status varchar(20) [not null, default: "success"]
  error_message text
  processing_status varchar(40) [not null, default: "RAW"]
  metadata jsonb [not null, default: "{}"]

  credibility_score float
  credibility_grade varchar(20)

  relevance_score float
  relevance_label varchar(20)
  relevance_reason text
  matched_companies jsonb [not null, default: "[]"]
  matched_sectors jsonb [not null, default: "[]"]

  cluster_id bigint
  is_representative boolean

  importance_level varchar(20)
  importance_score float
  qdrant_vector_id uuid

  indexes {
    url [unique]
    url_hash
    source_type
    source_name
    published_at
    processing_status
    company [type: gin]
    metadata [type: gin]
    matched_companies [type: gin]
    matched_sectors [type: gin]
    cluster_id
    is_representative
    qdrant_vector_id
  }
}

Table card_news {
  id varchar(30) [pk, note: "Generated by _generate_card_id(): IC-YYYYMMDD-NNN"]
  company varchar(50) [not null]
  cluster_id bigint

  title varchar(500) [not null]
  summary_lines text[] [not null, default: "{}"]

  event_type varchar(50) [not null, default: "tech"]
  importance varchar(20) [not null, default: "low"]
  importance_score float [not null, default: 0.0]

  implication jsonb [not null, default: "{}", note: "Stores v3 sector, sectors, exposure_score, exposure_band, signals, evidence_chain."]
  sources jsonb [not null, default: "[]"]

  validation_pass boolean [not null, default: false]
  validation_sc_score float [not null, default: 0.0]

  indexes {
    company
    cluster_id
    event_type
    importance
    validation_pass
  }
}

Table evidence_chain {
  issue_card_id varchar(30) [pk]

  source_links jsonb [not null, default: "[]"]
  provenance jsonb [not null, default: "{}"]
  financial_refs jsonb [not null, default: "[]"]
  mbb_refs jsonb [not null, default: "[]"]
  financial_link jsonb [not null, default: "{}"]

  evidence_version varchar(20) [not null, default: "v3.0"]
  pass boolean [not null, default: false]
  missing text[] [not null, default: "{}"]

  indexes {
    pass
    evidence_version
  }
}

Table pipeline_logs {
  id bigint [pk, increment]

  pipeline_step varchar(50) [not null]
  company varchar(50)
  input_count int [not null, default: 0]
  output_count int [not null, default: 0]
  elapsed_ms int [not null, default: 0]
  llm_tokens_used int [not null, default: 0]
  error_msg text

  indexes {
    pipeline_step
    company
  }
}

Ref: evidence_chain.issue_card_id - card_news.id
Ref: card_news.cluster_id > raw_articles.cluster_id
