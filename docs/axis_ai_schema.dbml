Project axis_ai {
  database_type: "PostgreSQL"
  Note: '''
    Current axis-ai DB schema from code write/read paths and the
    IssueIntegrationAgent storage contract.

    Source of truth used for this DBML:
    - src/db/article_store.py
    - src/agents/crawler_agent.py
    - src/agents/credibility_agent.py
    - src/agents/relevance_agent.py
    - src/agents/dedup_agent.py
    - src/agents/classification_agent.py
    - src/rag/vector_index.py
    - docs/issue-integration-output-contract.md
    - axis-backend/src/main/resources/db/migration/V39__add_integrated_issue_storage.sql
  '''
}

Table raw_articles {
  id bigint [pk, increment]

  source_type varchar(50) [not null]
  source_name varchar(100) [not null]
  publisher varchar(150)

  title varchar(500) [not null]
  content text
  url text [not null, unique]
  url_hash varchar(32) [not null]

  published_at timestamptz
  collected_at timestamptz [not null]

  company jsonb [not null, default: "[]", note: "Array of company ids. Industry-only material is stored as ['industry_trend']."]
  language varchar(10) [not null, default: "ko"]
  content_type varchar(30) [not null]

  crawl_status varchar(20) [not null, default: "success"]
  error_message text
  processing_status varchar(40) [not null, default: "RAW"]
  metadata jsonb [not null, default: "{}"]

  credibility_score float
  credibility_grade varchar(20)

  relevance_score float
  relevance_label varchar(20)
  relevance_reason text
  matched_companies jsonb [not null, default: "[]"]
  matched_sectors jsonb [not null, default: "[]"]

  cluster_id bigint
  is_representative boolean

  importance_level varchar(20)
  importance_score float
  qdrant_vector_id uuid

  indexes {
    url [unique]
    url_hash
    source_type
    source_name
    published_at
    processing_status
    company [type: gin]
    metadata [type: gin]
    matched_companies [type: gin]
    matched_sectors [type: gin]
    cluster_id
    is_representative
    qdrant_vector_id
  }
}

Table card_news {
  id varchar(30) [pk, note: "Generated by _generate_card_id(): IC-YYYYMMDD-NNN"]
  company varchar(50) [not null]
  cluster_id bigint
  integrated_issue_id uuid [note: "Nullable FK to the IntegratedIssue payload used to generate this card."]

  title varchar(500) [not null]
  summary_lines text[] [not null, default: "{}"]

  event_type varchar(50) [not null, default: "tech"]
  importance varchar(20) [not null, default: "low"]
  importance_score float [not null, default: 0.0]

  implication jsonb [not null, default: "{}", note: "Stores v3 sector, sectors, exposure_score, exposure_band, signals, evidence_chain."]
  sources jsonb [not null, default: "[]"]

  validation_pass boolean [not null, default: false]
  validation_sc_score float [not null, default: 0.0]

  indexes {
    company
    cluster_id
    integrated_issue_id
    event_type
    importance
    validation_pass
  }
}

Table integrated_issues {
  id uuid [pk]

  schema_version varchar(40) [not null, default: "integrated_issue_v3"]
  issue_key varchar(160) [not null, note: "Stable idempotency key generated from cluster_id/raw_article_id/schema_version."]

  cluster_id bigint
  representative_raw_article_id bigint [note: "Representative/analyzed raw_articles.id when the issue is cluster based."]

  main_company varchar(80)
  event_type varchar(80)
  source_family varchar(40)
  scope_type varchar(40)

  is_valid boolean [not null, default: false]
  confidence float
  status varchar(30) [not null, default: "active", note: "active/superseded/failed/review"]
  is_current boolean [not null, default: true]
  superseded_by uuid

  headline text
  one_line_summary text
  analyzed_source_ids bigint[] [not null, default: "{}"]
  source_ids bigint[] [not null, default: "{}"]
  sectors text[] [not null, default: "{}"]
  mentioned_peer_companies text[] [not null, default: "{}"]

  content_summary text
  content_detailed_explanation text
  content_has_content boolean [not null, default: false]
  content_compression_method varchar(80)
  content_basis_scope varchar(80)
  content_source_count int [not null, default: 0]
  content_section_count int [not null, default: 0]

  issue_brief jsonb [not null, default: "{}"]
  analysis_ready_inputs jsonb [not null, default: "{}"]
  content_digest jsonb [not null, default: "{}"]
  issue_frame jsonb [not null, default: "{}"]
  sources jsonb [not null, default: "[]"]
  evidence jsonb [not null, default: "{}"]
  quality jsonb [not null, default: "{}"]
  metadata jsonb [not null, default: "{}"]
  payload jsonb [not null, default: "{}", note: "Full IssueIntegrationAgent output."]

  payload_hash varchar(64)
  global_search_text text [not null, default: ""]

  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (schema_version, issue_key, is_current) [name: "idx_integrated_issues_schema_issue_key_current"]
    (cluster_id, is_current, created_at)
    (representative_raw_article_id, created_at)
    (main_company, event_type, created_at)
    (is_valid, is_current, created_at)
    analyzed_source_ids [type: gin]
    source_ids [type: gin]
    sectors [type: gin]
    mentioned_peer_companies [type: gin]
    payload [type: gin]
    content_digest [type: gin]
    issue_frame [type: gin]
    evidence [type: gin]
    global_search_text [type: gin]
  }
}

Table integrated_issue_source_articles {
  id bigint [pk, increment]
  integrated_issue_id uuid [not null]
  raw_article_id bigint

  source_order int [not null, default: 0]
  is_analyzed_basis boolean [not null, default: false]

  title text
  source_name varchar(100)
  source_type varchar(50)
  publisher varchar(150)
  published_at timestamptz
  url text
  relevance_label varchar(30)
  relevance_score float

  source_payload jsonb [not null, default: "{}"]
  created_at timestamptz [not null]

  indexes {
    (integrated_issue_id, raw_article_id) [unique]
    (integrated_issue_id, source_order)
    raw_article_id
    (integrated_issue_id, is_analyzed_basis)
    source_payload [type: gin]
  }
}

Table integrated_issue_content_sections {
  id bigint [pk, increment]
  integrated_issue_id uuid [not null]

  section_key varchar(80) [not null]
  section_order int [not null, default: 0]
  title text
  summary text
  details text
  key_points text[] [not null, default: "{}"]
  raw_article_ids bigint[] [not null, default: "{}"]
  evidence_ref_ids text[] [not null, default: "{}"]

  section_payload jsonb [not null, default: "{}"]
  created_at timestamptz [not null]

  indexes {
    (integrated_issue_id, section_key) [unique]
    (integrated_issue_id, section_order)
    section_key
    raw_article_ids [type: gin]
    evidence_ref_ids [type: gin]
    section_payload [type: gin]
  }
}

Table integrated_issue_evidence_references {
  id bigint [pk, increment]
  integrated_issue_id uuid [not null]

  evidence_ref_id varchar(40) [not null]
  evidence_text text [not null]
  source_ids bigint[] [not null, default: "{}"]

  reference_payload jsonb [not null, default: "{}"]
  created_at timestamptz [not null]

  indexes {
    (integrated_issue_id, evidence_ref_id) [unique]
    integrated_issue_id
    source_ids [type: gin]
    evidence_text [type: gin]
  }
}

Table evidence_chain {
  issue_card_id varchar(30) [pk]

  source_links jsonb [not null, default: "[]"]
  provenance jsonb [not null, default: "{}"]
  financial_refs jsonb [not null, default: "[]"]
  mbb_refs jsonb [not null, default: "[]"]
  financial_link jsonb [not null, default: "{}"]

  evidence_version varchar(20) [not null, default: "v3.0"]
  pass boolean [not null, default: false]
  missing text[] [not null, default: "{}"]

  indexes {
    pass
    evidence_version
  }
}

Table pipeline_logs {
  id bigint [pk, increment]

  pipeline_step varchar(50) [not null]
  company varchar(50)
  input_count int [not null, default: 0]
  output_count int [not null, default: 0]
  elapsed_ms int [not null, default: 0]
  llm_tokens_used int [not null, default: 0]
  error_msg text

  indexes {
    pipeline_step
    company
  }
}

Ref: evidence_chain.issue_card_id - card_news.id
Ref: card_news.cluster_id > raw_articles.cluster_id
Ref: card_news.integrated_issue_id > integrated_issues.id
Ref: integrated_issues.representative_raw_article_id > raw_articles.id
Ref: integrated_issues.superseded_by > integrated_issues.id
Ref: integrated_issue_source_articles.integrated_issue_id > integrated_issues.id
Ref: integrated_issue_source_articles.raw_article_id > raw_articles.id
Ref: integrated_issue_content_sections.integrated_issue_id > integrated_issues.id
Ref: integrated_issue_evidence_references.integrated_issue_id > integrated_issues.id
